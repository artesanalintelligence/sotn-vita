# Link setup of the PS Vita executable for release builds, which blank the
# data that comes from the game disc out of the executable and restore it at
# startup (see tools/vita/RELEASE.md).

# vita_writable_rodata(<target>)
#
# Links <target> with the toolchain's default linker script where the
# read-only data (.rodata) is moved from the text segment, which the Vita maps
# read-only, to the data segment, so that vita_assets.c can restore it too.
function(vita_writable_rodata target)
    execute_process(COMMAND ${CMAKE_LINKER} --verbose
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
    set(_sep "==================================================")
    string(FIND "${_out}" "${_sep}" _a)
    string(FIND "${_out}" "${_sep}" _b REVERSE)
    if(_rc OR _a LESS 0 OR _b LESS_EQUAL _a)
        message(FATAL_ERROR
            "could not read the default linker script of ${CMAKE_LINKER}")
    endif()
    string(LENGTH "${_sep}" _len)
    math(EXPR _a "${_a} + ${_len}")
    math(EXPR _n "${_b} - ${_a}")
    string(SUBSTRING "${_out}" ${_a} ${_n} _script)

    set(_ro "  .rodata         : { *(.rodata .rodata.* .gnu.linkonce.r.*) }\n")
    set(_data "  .data           :\n")
    string(FIND "${_script}" "${_ro}" _i)
    string(FIND "${_script}" "${_data}" _j)
    if(_i LESS 0 OR _j LESS 0)
        message(FATAL_ERROR "the default linker script of ${CMAKE_LINKER} "
            "has an unexpected layout, update tools/vita/vita_link.cmake")
    endif()
    string(REPLACE "${_ro}" "" _script "${_script}")
    string(REPLACE "${_data}" "${_ro}${_data}" _script "${_script}")

    set(_ld "${CMAKE_BINARY_DIR}/vita_writable_rodata.ld")
    file(WRITE "${_ld}.tmp"
        "/* generated by tools/vita/vita_link.cmake, do not edit */\n${_script}")
    file(COPY_FILE "${_ld}.tmp" "${_ld}" ONLY_IF_DIFFERENT)
    file(REMOVE "${_ld}.tmp")
    target_link_options(${target} PRIVATE "-Wl,-T,${_ld}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${_ld}")
endfunction()

# vita_link_map(<target>)
#
# Writes <target>.map next to the executable: mkblank.py uses it to keep the
# data of the toolchain libraries, which run before the restore.
function(vita_link_map target)
    target_link_options(${target} PRIVATE
        "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/${target}.map")
endfunction()
